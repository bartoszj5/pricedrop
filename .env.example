POSTGRES_USER=pricedrop
POSTGRES_PASSWORD=pricedrop
POSTGRES_DB=pricedrop
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Redis — optional; when set, must match redis service (docker-compose) requirepass
REDIS_PASSWORD=

# API — JWT cookies / bearer (SECRET_KEY must be set when ENVIRONMENT=production)
SECRET_KEY=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://YOUR_PUBLIC_IP:3000

COOKIE_SECURE=

ITAD_API_KEY=
ITAD_BASE_URL=https://api.isthereanydeal.com
ITAD_TIMEOUT_SECONDS=20
SCRAPE_INTERVAL=6h
CRAWL_INTERVAL=24h

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
SMTP_STARTTLS=1

# Internal API token — required to authorize /internal endpoints (e.g. cache invalidation from scraper)
INTERNAL_API_TOKEN=
